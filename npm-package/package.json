{
  "name": "dsh-kb-rag",
  "version": "1.6.0",
  "description": "Local literature knowledge-base RAG tools for DSH: hybrid retrieval + rerank + cited answers over a SQLite index (bundled Python engine).",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-kb-rag-install": "./install.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "install.mjs",
    "kb_engine.py",
    "cordis.patch.yml",
    "scripts/install.ps1",
    "scripts/install.sh",
    "scripts/doi_pdf.mjs",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "rag",
    "knowledge-base",
    "literature",
    "zotero",
    "sqlite",
    "embedding",
    "rerank"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Breeze136/dsh-kb-rag.git",
    "directory": "npm-package"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "engines": {
    "node": ">=18"
  }
}
